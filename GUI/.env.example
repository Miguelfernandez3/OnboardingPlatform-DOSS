# Tipo de adapter a usar: 'doss' o 'json-server'
VITE_API_ADAPTER=doss

# URL base de la API (desarrollo local).
# Para el build Docker con proxy nginx, en el compose usar: GUI_VITE_API_BASE_URL=/api
VITE_API_BASE_URL=http://localhost:4321/api

# Entorno para activar funciones de desarrollo. development | production
VITE_ENV=development