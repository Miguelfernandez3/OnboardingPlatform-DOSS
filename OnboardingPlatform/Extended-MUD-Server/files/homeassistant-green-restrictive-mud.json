{
  "ietf-mud:mud": {
    "mud-version": 1,
    "cache-validity": 48,
    "is-supported": true,
    "last-change": "2026-02-23T12:00:00Z",
    "mud-url": "https://drive.google.com/uc?export=download&id=1WhyIdgJzQchZLwDGHkfGtCKhwf6cULaW",
    "mud-signature": "https://example.com/mud/home-assistant-green.p7s",
    "mfg-name": "Nabu Casa",
    "documentation": "https://www.home-assistant.io/green/",
    "systeminfo": "Home Assistant Green smart home controller",
    "extensions": [
      "umu-mspl-list:mspls"
    ],
    "from-device-policy": {
      "access-lists": {
        "access-list": [
          {
            "name": "fripv4-acl-ha-restrict"
          }
        ]
      }
    },
    "to-device-policy": {
      "access-lists": {
        "access-list": [
          {
            "name": "toipv4-acl-ha-restrict"
          }
        ]
      }
    }
  },
  "ietf-access-control-list:acls": {
    "acl": [
      {
        "name": "toipv4-acl-ha-restrict",
        "type": "ipv4-acl-type",
        "aces": {
          "ace": [
            {
              "name": "toace-my-controller-deny",
              "matches": {
                "ietf-mud:mud": {
                  "my-controller": [
                    null
                  ]
                }
              },
              "actions": {
                "forwarding": "drop"
              }
            },
            {
              "name": "toace-local-networks-deny",
              "matches": {
                "ietf-mud:mud": {
                  "local-networks": [
                    null
                  ]
                },
                "ipv4": {
                  "protocol": 6
                }
              },
              "actions": {
                "forwarding": "drop"
              }
            },
            {
              "name": "toace-same-manufacturer-deny",
              "matches": {
                "ietf-mud:mud": {
                  "same-manufacturer": [
                    null
                  ]
                }
              },
              "actions": {
                "forwarding": "drop"
              }
            }
          ]
        }
      },
      {
        "name": "fripv4-acl-ha-restrict",
        "type": "ipv4-acl-type",
        "aces": {
          "ace": [
            {
              "name": "frace-my-controller-deny",
              "matches": {
                "ietf-mud:mud": {
                  "my-controller": [
                    null
                  ]
                }
              },
              "actions": {
                "forwarding": "drop"
              }
            },
            {
              "name": "frace-local-networks-deny",
              "matches": {
                "ietf-mud:mud": {
                  "local-networks": [
                    null
                  ]
                },
                "ipv4": {
                  "protocol": 6
                }
              },
              "actions": {
                "forwarding": "drop"
              }
            },
            {
              "name": "frace-same-manufacturer-deny",
              "matches": {
                "ietf-mud:mud": {
                  "same-manufacturer": [
                    null
                  ]
                }
              },
              "actions": {
                "forwarding": "drop"
              }
            }
          ]
        }
      }
    ]
  },
  "umu-mspl-list:mspls": {
    "mspl": [
      {
        "name": "ha-lock-bedroom-external-mitigation",
        "type": "homeassistant-rest-command-mspl-type",
        "automation-id": "lock_bedroom_external",
        "configuration": {
          "capability": "access-restriction"
        },
        "enforcement-profile": "homeassistant-rest-lock-bedroom-external",
        "description": "Restrict access by triggering Home Assistant rest_command lock_bedroom_external"
      }
    ]
  }
}
