{
  "ietf-mud:mud": {
    "mud-version": 1,
    "cache-validity": 48,
    "is-supported": true,
    "last-change": "2026-03-26T00:00:00Z",
    "mud-url": "https://MudServer/bme-generic-device-restrictive-mud",
    "mud-signature": "https://example.com/mud/bme-generic-device-restrictive-mud.p7s",
    "mfg-name": "BME",
    "documentation": "https://bme.example.com/devices/bme-generic-device",
    "systeminfo": "BME Generic Device - restrictive MUD with UM REST configuration support",
    "extensions": [
      "umu-mspl-list:mspls"
    ],
    "ietf-access-control-list:acls": {
      "acl": [
        {
          "name": "bme_toipv4_acl",
          "type": "ipv4-acl-type",
          "aces": {
            "ace": [
              {
                "name": "to_my_controller_allow",
                "matches": {
                  "ietf-mud:mud": {
                    "my-controller": [
                      null
                    ]
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              },
              {
                "name": "to_local_networks_tcp_allow",
                "matches": {
                  "ietf-mud:mud": {
                    "local-networks": [
                      null
                    ]
                  },
                  "ipv4": {
                    "protocol": 6
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              },
              {
                "name": "to_same_manufacturer_allow",
                "matches": {
                  "ietf-mud:mud": {
                    "same-manufacturer": [
                      null
                    ]
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              }
            ]
          }
        },
        {
          "name": "bme_fripv4_acl",
          "type": "ipv4-acl-type",
          "aces": {
            "ace": [
              {
                "name": "fr_my_controller_allow",
                "matches": {
                  "ietf-mud:mud": {
                    "my-controller": [
                      null
                    ]
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              },
              {
                "name": "fr_local_networks_tcp_allow",
                "matches": {
                  "ietf-mud:mud": {
                    "local-networks": [
                      null
                    ]
                  },
                  "ipv4": {
                    "protocol": 6
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              },
              {
                "name": "fr_same_manufacturer_allow",
                "matches": {
                  "ietf-mud:mud": {
                    "same-manufacturer": [
                      null
                    ]
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              }
            ]
          }
        },
        {
          "name": "bme_from_device_rv",
          "type": "ipv4-acl-type",
          "aces": {
            "ace": [
              {
                "name": "allow_rv_tcp_8080",
                "matches": {
                  "ipv4": {
                    "protocol": 6
                  },
                  "tcp": {
                    "destination-port": {
                      "operator": "eq",
                      "port": 8080
                    }
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              }
            ]
          }
        }
      ]
    },
    "from-device-policy": {
      "access-lists": {
        "access-list": [
          {
            "name": "bme_fripv4_acl"
          },
          {
            "name": "bme_from_device_rv"
          }
        ]
      },
      "mspl-list": {
        "mspls": [
          {
            "name": "bme-configure-service"
          }
        ]
      }
    },
    "to-device-policy": {
      "access-lists": {
        "access-list": [
          {
            "name": "bme_toipv4_acl"
          }
        ]
      },
      "mspl-list": {
        "mspls": [
          {
            "name": "bme-configure-service"
          }
        ]
      }
    }
  },
  "umu-mspl-list:mspls": {
    "mspl": [
      {
        "name": "bme-configure-service",
        "type": "bme-rest-configure-service-mspl-type",
        "configuration": {
          "capability": "service-configuration"
        },
        "enforcement-profile": "bme-rest-configure-service",
        "description": "Configure BME device service by invoking HTTP POST /configureService with a service/action/data payload"
      }
    ]
  }
}
