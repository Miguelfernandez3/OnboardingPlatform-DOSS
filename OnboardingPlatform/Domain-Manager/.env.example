# =============================================================================
# VARIABLES OBLIGATORIAS
# =============================================================================

# JWT Secret Key - OBLIGATORIO
# Clave secreta para firmar y verificar tokens JWT
# Mínimo 32 caracteres recomendado
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANTE: Usa la MISMA clave en Domain-Manager, Extended-MUD-Manager y Extended-MUD-Server
JWT_SECRET_KEY=

# Credenciales del Administrador Inicial - OBLIGATORIO
# El usuario admin se creará automáticamente al iniciar la aplicación si no existe
ADMIN_EMAIL=admin@obp.com
ADMIN_PASSWORD=admin123

# =============================================================================
# VARIABLES OPCIONALES
# =============================================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Si no se especifica, se usa DEBUG por defecto
LOG_LEVEL=DEBUG

# Salida de logs (STDOUT, STDERR, o nombre de archivo)
# Si no se especifica, se usa STDOUT y archivo DeviceDomainManager.log
LOG_OUTPUT=STDOUT

# Puerto donde el servidor escuchará
# Si no se especifica, se usa 4321 por defecto (definido en app.py)
DADM_PORT=4321

# URL del repositorio de software
# Ejemplo: http://localhost:8081
SOFTWARE_REPO_URL=http://localhost:8081

# URL del inventario y registro
# Ejemplo: http://localhost:8080/chain/
INV_REG_URL=http://localhost:8080/chain/

# URL del IDM (Identity Management)
# Ejemplo: https://localhost:9082/fluidos/idm/
IDM_URL=https://localhost:9082/fluidos/idm/

# URL de la API SUUA
# Ejemplo: https://suua.api.certify.digital-worx.de/
SUUA_URL=https://suua.api.certify.digital-worx.de/

# Token de Home Assistant para autenticación en la API REST
HOME_ASSISTANT_TOKEN=TU_TOKEN_REAL_DE_HOME_ASSISTANT
