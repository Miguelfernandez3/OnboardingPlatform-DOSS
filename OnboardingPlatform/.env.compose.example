# Shared auth secret (same value for Domain-Manager, MUD-Manager and MUD-Server)
# Generate new: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=BpTc694m9AVfCy7wuk4sW62iHe38xHp7xyfdCmQuq9I

# Initial admin user for Domain-Manager
ADMIN_EMAIL=admin@obp.com
ADMIN_PASSWORD=admin123

# Optional integrations (see OnboardingPlatform/Fake-FEAM/README.md)
# In docker-compose, domain-manager defaults to http://fake-feam:8181 if FEAM_SERVER_URL is unset.
# For FEAM on the host: use http://host.docker.internal:8181
FEAM_SERVER_URL=http://fake-feam:8185
# Session UUID sent to FEAM (checkPin, callResourceServer, etc.); overrides config.yaml
FEAM_SESSION_ID=89c0170d-2ab8-41ac-9fe3-17ab0a682d54

# Optional logging for Domain-Manager
LOG_LEVEL=DEBUG
LOG_OUTPUT=STDOUT

# Persistent SQLite database path inside the Domain-Manager container
DADM_DATABASE_PATH=/var/lib/onboardingplatform/domain-manager/DeviceDomainManager.db

# -----------------------------------------------------------------------------
# Enforcement (admin API: profiles, mappings, secrets)
# Required for /api/admin/enforcement/secrets to work (no 500)
# -----------------------------------------------------------------------------
# AES-GCM keys for encrypting enforcement secrets. Format: JSON object {"version":"base64-32bytes"}
# Generate a new key: python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENFORCEMENT_KEYS_JSON={"v1":"nwroqJD6rPUJ8GrxASw2F73Dy0pLkHPJyJFEXyv2+Cs="}
# Active key version (must exist in ENFORCEMENT_KEYS_JSON)
ENFORCEMENT_ACTIVE_KEY_VERSION=v1
# Comma-separated hosts allowed in enforcement profile endpoint URLs (e.g. https://this-host/path)
# Use .domain.com to allow all subdomains. Use * to allow any domain (no host check).
# Default if empty: localhost,127.0.0.1,::1
ENFORCEMENT_ALLOWED_HOSTS=localhost,127.0.0.1,::1,160.40.54.46

# Optional: JWT tokens for scripts/seed_ha_enforcement.py (do not commit real values)
# HA_MAIN_BEARER=
# HA_LAMP_BEARER=

# Internal auth toggles (recommended false for local Docker integration)
MUD_MANAGER_REQUIRE_AUTH=false
THREAT_MUD_MANAGER_REQUIRE_AUTH=false
MUD_SERVER_REQUIRE_AUTH=false

# Global localhost aliases by port (used to rewrite localhost URLs inside containers)
# format: <port>:<service-name>,<port>:<service-name>,...
LOCALHOST_ALIAS_BY_PORT=8091:mud-server,8888:mud-manager,8889:threat-mud-manager,4321:domain-manager,3001:gui

# Fallback aliases when port is not present in LOCALHOST_ALIAS_BY_PORT
MUD_LOCALHOST_ALIAS=mud-server
THREAT_MUD_LOCALHOST_ALIAS=mud-server

# GUI build-time config
# Con la GUI servida desde Docker (nginx), usar /api para que el proxy interno funcione.
GUI_VITE_API_ADAPTER=doss
GUI_VITE_API_BASE_URL=/api
GUI_VITE_ENV=production

# Allow DSP fallback for development environments
ALLOW_DSP_FALLBACK=true

# Polling intervals for FEAM and DSP threat refresh
FEAM_SYNC_POLL_INTERVAL_SECONDS=5
DSP_THREAT_POLL_INTERVAL_SECONDS=5


# Telegram / notificaciones (Domain-Manager + worker)
# Webhook público: misma base que la GUI (nginx del contenedor gui), ruta /webhooks/telegram — NO usar :4321 si la API no está expuesta.
# Ejemplo setWebhook url: https://tu-dominio/webhooks/telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=un_secreto_largo_aleatorio
# Opcional si getMe no es usable desde el contenedor:
# TELEGRAM_BOT_USERNAME=MiBot

# Opcional (por defecto true en docker-compose)
# NOTIFICATIONS_ENABLED=true
# TELEGRAM_NOTIFICATIONS_ENABLED=true

# Opcional (por defecto 12 horas)
# FEAM_FAILURE_NOTIFY_DEDUP_HOURS=12

# Opcional (por defecto 5 minutos; 0 = alerta inmediata, legacy)
# FEAM_FAILURE_NOTIFY_GRACE_MINUTES=5
